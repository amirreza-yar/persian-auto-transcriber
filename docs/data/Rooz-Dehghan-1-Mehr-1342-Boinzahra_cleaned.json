{
  "version": "cleaned",
  "source_name": "Rooz-Dehghan-1-Mehr-1342-Boinzahra.mp3",
  "cues": [
    {
      "id": "S000001",
      "start": 28.58,
      "end": 29.98,
      "text": "قریب یک سال پیش،",
      "paragraph_after": false
    },
    {
      "id": "S000002",
      "start": 30.0,
      "end": 32.8,
      "text": "مصیبت‌دیده بودند،",
      "paragraph_after": false
    },
    {
      "id": "S000003",
      "start": 32.8,
      "end": 35.52,
      "text": "به اینجا آمدم؛",
      "paragraph_after": false
    },
    {
      "id": "S000004",
      "start": 37.4,
      "end": 39.44,
      "text": "و امروز نیز",
      "paragraph_after": false
    },
    {
      "id": "S000005",
      "start": 41.04,
      "end": 44.56,
      "text": "برای شرکت در جشن دهقان",
      "paragraph_after": false
    },
    {
      "id": "S000006",
      "start": 44.56,
      "end": 46.68,
      "text": "و ضمناً",
      "paragraph_after": false
    },
    {
      "id": "S000007",
      "start": 47.98,
      "end": 51.04,
      "text": "بازرسی از کارهایی که در این یک سال",
      "paragraph_after": false
    },
    {
      "id": "S000008",
      "start": 51.04,
      "end": 56.64,
      "text": "برای بنای جدید دهات خراب‌شده",
      "paragraph_after": false
    },
    {
      "id": "S000009",
      "start": 56.64,
      "end": 59.3,
      "text": "و همچنین",
      "paragraph_after": false
    },
    {
      "id": "S000010",
      "start": 60.54,
      "end": 62.9,
      "text": "پرسش از کسانی که باقی‌مانده‌اند",
      "paragraph_after": false
    },
    {
      "id": "S000011",
      "start": 66.5,
      "end": 76.34,
      "text": "و دیدن روحیه جدیدی که در باقی‌ماندگان ایجاد شده است،",
      "paragraph_after": false
    },
    {
      "id": "S000012",
      "start": 76.34,
      "end": 79.2,
      "text": "در اینجا حضور دارم.",
      "paragraph_after": true
    },
    {
      "id": "S000013",
      "start": 81.76,
      "end": 90.3,
      "text": "زلزله‌ای که پارسال در این صفحات پدید آمد،",
      "paragraph_after": false
    },
    {
      "id": "S000014",
      "start": 92.12,
      "end": 98.94,
      "text": "با کمال تأسف بیش از ده هزار نفر تلفات داشت",
      "paragraph_after": false
    },
    {
      "id": "S000015",
      "start": 100.14,
      "end": 104.98,
      "text": "و در حدود سی هزار نفر بی‌خانمان شدند.",
      "paragraph_after": true
    },
    {
      "id": "S000016",
      "start": 106.76,
      "end": 108.96,
      "text": "اقداماتی که تاکنون شده است،",
      "paragraph_after": false
    },
    {
      "id": "S000017",
      "start": 108.96,
      "end": 120.0,
      "text": "آن چیزی که از دست مؤسسات ایرانی، خیرخواهان ایرانی و",
      "paragraph_after": false
    },
    {
      "id": "S000018",
      "start": 120.4,
      "end": 127.8,
      "text": "تماماً به نحوی از انحاء در تجدید بنای این دهات ساخته بود",
      "paragraph_after": false
    },
    {
      "id": "S000019",
      "start": 127.8,
      "end": 143.0,
      "text": "و همچنین کمک‌های ذی‌قیمتی که ممالک دوست و افراد بشردوست و خیرخواهی که از خارج به این مملکت کمک کرده‌اند،",
      "paragraph_after": false
    },
    {
      "id": "S000020",
      "start": 143.0,
      "end": 146.92,
      "text": "باعث کمال قدردانی هست.",
      "paragraph_after": false
    },
    {
      "id": "S000021",
      "start": 148.0,
      "end": 159.18,
      "text": "منتها اقداماتی که انجام‌گرفته است جوابگوی تمام احتیاجات ساکنین آسیب‌دیده نمی‌باشد",
      "paragraph_after": false
    },
    {
      "id": "S000022",
      "start": 159.18,
      "end": 162.36,
      "text": "و سعی ما در آتیه باید",
      "paragraph_after": false
    },
    {
      "id": "S000023",
      "start": 162.36,
      "end": 174.38,
      "text": "این باشد که تمام دهات خراب‌شده را بتوانیم برای باقی‌ماندگان آنها",
      "paragraph_after": false
    },
    {
      "id": "S000024",
      "start": 174.38,
      "end": 180.0,
      "text": "پناه‌گاه کافی و وسیله زندگی",
      "paragraph_after": false
    },
    {
      "id": "S000025",
      "start": 180.06,
      "end": 184.12,
      "text": "و وسیله کشاورزی و امرار معاش فراهم کنیم.",
      "paragraph_after": true
    },
    {
      "id": "S000026",
      "start": 186.84,
      "end": 187.96,
      "text": "ضمناً",
      "paragraph_after": false
    },
    {
      "id": "S000027",
      "start": 189.42,
      "end": 193.3,
      "text": "در این دشت پهناور",
      "paragraph_after": false
    },
    {
      "id": "S000028",
      "start": 195.68,
      "end": 200.16,
      "text": "یک برنامه عمرانی در نظر داریم",
      "paragraph_after": false
    },
    {
      "id": "S000029",
      "start": 200.16,
      "end": 205.74,
      "text": "که شاید برای تمام مملکت نمونه باشد؛",
      "paragraph_after": false
    },
    {
      "id": "S000030",
      "start": 207.22,
      "end": 216.18,
      "text": "یعنی یک کشاورز با اصول جدید در چه نوع خانه زندگی کند",
      "paragraph_after": false
    },
    {
      "id": "S000031",
      "start": 216.18,
      "end": 220.86,
      "text": "که بیشتر وسیله رفاه و آسایش او را فراهم کند،",
      "paragraph_after": false
    },
    {
      "id": "S000032",
      "start": 220.86,
      "end": 226.86,
      "text": "چه شکلی زمین خودش را با چه وسایلی زراعت کند،",
      "paragraph_after": false
    },
    {
      "id": "S000033",
      "start": 226.86,
      "end": 229.38,
      "text": "طرز آبیاری چه باشد،",
      "paragraph_after": false
    },
    {
      "id": "S000034",
      "start": 229.38,
      "end": 232.18,
      "text": "طرز کود دادن چه باشد،",
      "paragraph_after": false
    },
    {
      "id": "S000035",
      "start": 232.18,
      "end": 234.02,
      "text": "دامداری چه باشد؛",
      "paragraph_after": false
    },
    {
      "id": "S000036",
      "start": 234.02,
      "end": 239.62,
      "text": "و امیدواریم این برنامه نمونه را",
      "paragraph_after": false
    },
    {
      "id": "S000037",
      "start": 240.54,
      "end": 245.16,
      "text": "هر قیمتی که باشد شروع و به اتمام برسانیم",
      "paragraph_after": false
    },
    {
      "id": "S000038",
      "start": 245.16,
      "end": 254.2,
      "text": "و این خود نمونه‌ای باشد برای تمام اقدامات بعدی چه دولتی و چه خصوصی.",
      "paragraph_after": true
    },
    {
      "id": "S000039",
      "start": 258.82,
      "end": 269.64,
      "text": "و اما در این روز باید از اصلاحات ارضی که در این مملکت صورت گرفته است",
      "paragraph_after": false
    },
    {
      "id": "S000040",
      "start": 269.64,
      "end": 271.64,
      "text": "ذکری بکنم.",
      "paragraph_after": true
    },
    {
      "id": "S000041",
      "start": 273.96,
      "end": 276.7,
      "text": "اصلاحات ارضی همان‌طوری که می‌دانید،",
      "paragraph_after": false
    },
    {
      "id": "S000042",
      "start": 276.7,
      "end": 282.0,
      "text": "سعی کردم که در ۱۳۲۹",
      "paragraph_after": false
    },
    {
      "id": "S000043",
      "start": 283.08,
      "end": 287.4,
      "text": "با تقسیم املاک شخصی خود شروع کنم.",
      "paragraph_after": false
    },
    {
      "id": "S000044",
      "start": 292.4,
      "end": 299.84,
      "text": "بعد از مدت کوتاهی متأسفانه وضع مملکت ما دستخوش حوادث",
      "paragraph_after": false
    },
    {
      "id": "S000045",
      "start": 300.0,
      "end": 307.98,
      "text": "شد و کسانی که در آن موقع زمامدار دولت بودند",
      "paragraph_after": false
    },
    {
      "id": "S000046",
      "start": 307.98,
      "end": 315.22,
      "text": "به آن برنامه خاتمه دادند و برای مدت کوتاهی متوقف شد.",
      "paragraph_after": false
    },
    {
      "id": "S000047",
      "start": 317.98,
      "end": 327.42,
      "text": "بعدها فهمیدیم که آن نظر متوقف کردن این برنامه چه معنایی داشت.",
      "paragraph_after": false
    },
    {
      "id": "S000048",
      "start": 329.94,
      "end": 335.5,
      "text": "معنای متوقف کردن این برنامه در ۱۳۳۱ را",
      "paragraph_after": false
    },
    {
      "id": "S000049",
      "start": 335.5,
      "end": 343.46,
      "text": "ما در اتفاقاتی که در این یک سال اخیر در این مملکت افتاد فهمیدیم.",
      "paragraph_after": true
    },
    {
      "id": "S000050",
      "start": 344.8,
      "end": 355.04,
      "text": "یعنی همان حرفی که من در کنگره دهقان‌ها زده‌ام",
      "paragraph_after": false
    },
    {
      "id": "S000051",
      "start": 355.04,
      "end": 359.94,
      "text": "که در مقابل این نهضت بزرگ ما،",
      "paragraph_after": false
    },
    {
      "id": "S000052",
      "start": 360.0,
      "end": 362.8,
      "text": "این انقلاب ملی ما،",
      "paragraph_after": false
    },
    {
      "id": "S000053",
      "start": 362.8,
      "end": 364.56,
      "text": "دو قوه",
      "paragraph_after": false
    },
    {
      "id": "S000054",
      "start": 364.56,
      "end": 367.24,
      "text": "از پای نخواهند نشست",
      "paragraph_after": false
    },
    {
      "id": "S000055",
      "start": 367.24,
      "end": 369.54,
      "text": "و آن ارتجاع سیاه",
      "paragraph_after": false
    },
    {
      "id": "S000056",
      "start": 370.98,
      "end": 374.08,
      "text": "و قوا و مخرب سرخ",
      "paragraph_after": false
    },
    {
      "id": "S000057",
      "start": 375.44,
      "end": 379.58,
      "text": "با هم دست اتحاد خواهند داد",
      "paragraph_after": false
    },
    {
      "id": "S000058",
      "start": 379.58,
      "end": 382.32,
      "text": "تا مانع پیشرفت",
      "paragraph_after": false
    },
    {
      "id": "S000059",
      "start": 382.32,
      "end": 385.06,
      "text": "و سرفرازی این مملکت بشه.",
      "paragraph_after": false
    },
    {
      "id": "S000060",
      "start": 385.06,
      "end": 387.56,
      "text": "همین قوه",
      "paragraph_after": false
    },
    {
      "id": "S000061",
      "start": 387.56,
      "end": 398.94,
      "text": "و اتحاد این قوه بود که در ۱۳۳۱ به زمامداران کور وقت در واقع حکم کرد",
      "paragraph_after": false
    },
    {
      "id": "S000062",
      "start": 398.94,
      "end": 404.26,
      "text": "که در همون موقع این برنامه اصلاحات اراضی را متوقف کنند.",
      "paragraph_after": true
    },
    {
      "id": "S000063",
      "start": 408.72,
      "end": 416.66,
      "text": "بعد از مدتی خواستیم که اصلاحات اراضی شخصی خود را به مملکت تأمیم بدهیم.",
      "paragraph_after": true
    },
    {
      "id": "S000064",
      "start": 419.38,
      "end": 420.0,
      "text": "لایحه",
      "paragraph_after": false
    },
    {
      "id": "S000065",
      "start": 420.04,
      "end": 423.32,
      "text": "تقسیم خالصجات را به تصویب رساندیم",
      "paragraph_after": false
    },
    {
      "id": "S000066",
      "start": 425.7,
      "end": 435.2,
      "text": "و لایحه محدودیت اراضی زراعتی را نیز به مجلس دادیم.",
      "paragraph_after": true
    },
    {
      "id": "S000067",
      "start": 435.2,
      "end": 437.48,
      "text": "همون‌طوری که قبلاً گفتم",
      "paragraph_after": false
    },
    {
      "id": "S000068",
      "start": 437.48,
      "end": 441.38,
      "text": "این لایحه به یک طریقی وارد مجلس شد",
      "paragraph_after": false
    },
    {
      "id": "S000069",
      "start": 441.38,
      "end": 443.74,
      "text": "و به طریق دیگری خارج.",
      "paragraph_after": true
    },
    {
      "id": "S000070",
      "start": 445.22,
      "end": 447.46,
      "text": "درست اصطلاح معروف است",
      "paragraph_after": false
    },
    {
      "id": "S000071",
      "start": 447.46,
      "end": 453.54,
      "text": "که یک شیر برازنده خوش‌ترکیبی وارد مجلس شد",
      "paragraph_after": false
    },
    {
      "id": "S000072",
      "start": 453.54,
      "end": 459.28,
      "text": "و بدون یال و دم و اشکم خارج.",
      "paragraph_after": true
    },
    {
      "id": "S000073",
      "start": 460.72,
      "end": 461.76,
      "text": "چرا؟",
      "paragraph_after": true
    },
    {
      "id": "S000074",
      "start": 463.6,
      "end": 466.32,
      "text": "چون تا قبل از این انتخابات",
      "paragraph_after": false
    },
    {
      "id": "S000075",
      "start": 466.32,
      "end": 469.68,
      "text": "تا قبل از آزادی دهقان",
      "paragraph_after": false
    },
    {
      "id": "S000076",
      "start": 469.68,
      "end": 472.56,
      "text": "دلقای رژیم ارباب و رعیتی",
      "paragraph_after": false
    },
    {
      "id": "S000077",
      "start": 474.82,
      "end": 477.38,
      "text": "کشاورزان زحمت‌کش ایران",
      "paragraph_after": false
    },
    {
      "id": "S000078",
      "start": 477.38,
      "end": 479.96,
      "text": "و سایر طبقاتی",
      "paragraph_after": false
    },
    {
      "id": "S000079",
      "start": 480.0,
      "end": 488.08,
      "text": "که زنجیرهای اسارتی به اطراف آنها بسته شده بود",
      "paragraph_after": false
    },
    {
      "id": "S000080",
      "start": 488.08,
      "end": 494.58,
      "text": "در رفتن به پای صندوق از خود اراده‌ای نداشتند.",
      "paragraph_after": true
    },
    {
      "id": "S000081",
      "start": 494.58,
      "end": 498.98,
      "text": "مجبور بودند که اون چیزی که یا ارباب به اون‌ها می‌گفت",
      "paragraph_after": false
    },
    {
      "id": "S000082",
      "start": 498.98,
      "end": 505.18,
      "text": "یا صاحبان نفوذی که به هر قیمتی می‌خواستند",
      "paragraph_after": false
    },
    {
      "id": "S000083",
      "start": 505.18,
      "end": 511.54,
      "text": "یک منافع قدیمی و پوسیده‌ای را برای خود در مملکت حفظ کنند",
      "paragraph_after": false
    },
    {
      "id": "S000084",
      "start": 511.54,
      "end": 519.78,
      "text": "این‌ها در پر کردن صندوق‌های این مملکت نفوذ و تأثیر داشتند.",
      "paragraph_after": true
    },
    {
      "id": "S000085",
      "start": 521.48,
      "end": 527.16,
      "text": "پس اون لایه‌ای که به اون مجلس که به اون ترتیب تشکیل می‌شد",
      "paragraph_after": false
    },
    {
      "id": "S000086",
      "start": 527.16,
      "end": 531.56,
      "text": "بی‌ر از همون اتفاق که براش افتاد",
      "paragraph_after": false
    },
    {
      "id": "S000087",
      "start": 531.56,
      "end": 534.16,
      "text": "نمی‌بایستی که ما انتظاری داشته باشیم.",
      "paragraph_after": true
    },
    {
      "id": "S000088",
      "start": 534.16,
      "end": 535.7,
      "text": "تا این‌که بالاخره",
      "paragraph_after": false
    },
    {
      "id": "S000089",
      "start": 536.6,
      "end": 540.0,
      "text": "در مقابل مقایسه وضع",
      "paragraph_after": false
    },
    {
      "id": "S000090",
      "start": 540.12,
      "end": 548.32,
      "text": "خود ما با تمدن امروز جهان در سه سال پیش قریب سه سال پیش تصمیم گرفتیم",
      "paragraph_after": false
    },
    {
      "id": "S000091",
      "start": 548.32,
      "end": 554.94,
      "text": "که برای حفظ و بقای این مملکت منتظر حوادث نمی‌شود شد",
      "paragraph_after": false
    },
    {
      "id": "S000092",
      "start": 554.94,
      "end": 563.76,
      "text": "بلکه ما خودمون حوادث را باید بیافرینیم و بر اون‌ها فائق بشویم",
      "paragraph_after": false
    },
    {
      "id": "S000093",
      "start": 563.76,
      "end": 573.28,
      "text": "تا این‌که آینده مملکت خود را تأمین بکنیم و با ملل راقی دنیا برابر و همسر زندگانی کنیم.",
      "paragraph_after": true
    },
    {
      "id": "S000094",
      "start": 573.28,
      "end": 582.24,
      "text": "این است که مجبور شدیم برای انجام اصلاحات و پیشرفت‌های مملکت",
      "paragraph_after": false
    },
    {
      "id": "S000095",
      "start": 582.24,
      "end": 597.3,
      "text": "مدتی بدون دغدغه و اشکالاتی تصمیماتی که برای پیشرفت مملکت لازم بود انجام بدهیم.",
      "paragraph_after": true
    },
    {
      "id": "S000096",
      "start": 597.3,
      "end": 600.0,
      "text": "دو سال و نیم ما",
      "paragraph_after": false
    },
    {
      "id": "S000097",
      "start": 600.62,
      "end": 612.58,
      "text": "بدون نمایندگانی که مربوط به گذشته این مملکت بودند زندگی کردیم",
      "paragraph_after": false
    },
    {
      "id": "S000098",
      "start": 612.58,
      "end": 618.04,
      "text": "و نتیجه این دو سال و نیم همین است که امروز می‌بینید.",
      "paragraph_after": true
    },
    {
      "id": "S000099",
      "start": 618.04,
      "end": 629.86,
      "text": "یعنی در ششم بهمن با اون شور و شوقی که شما به پای صندوق‌های تصویب ملی رفتید",
      "paragraph_after": false
    },
    {
      "id": "S000100",
      "start": 629.86,
      "end": 636.48,
      "text": "انقلاب ایران صحه گذاردید و اون انقلاب ایران",
      "paragraph_after": false
    },
    {
      "id": "S000101",
      "start": 638.82,
      "end": 645.76,
      "text": "چیزیست که شما دهقان‌های ایران را آزاد کرد",
      "paragraph_after": false
    },
    {
      "id": "S000102",
      "start": 645.76,
      "end": 649.24,
      "text": "به رژیم ارباب و رعیتی خاتمه داد",
      "paragraph_after": false
    },
    {
      "id": "S000103",
      "start": 649.24,
      "end": 652.42,
      "text": "به کارگر ایرانی حق‌فعلی را بخشید",
      "paragraph_after": false
    },
    {
      "id": "S000104",
      "start": 652.42,
      "end": 656.28,
      "text": "به نصف جمعیت که اون هم زن‌های ایرانی‌ست",
      "paragraph_after": false
    },
    {
      "id": "S000105",
      "start": 656.28,
      "end": 658.12,
      "text": "آزادی داد",
      "paragraph_after": false
    },
    {
      "id": "S000106",
      "start": 658.12,
      "end": 660.0,
      "text": "و سایر موادی",
      "paragraph_after": false
    },
    {
      "id": "S000107",
      "start": 660.46,
      "end": 662.7,
      "text": "که معروف به مواد شش‌گانه است",
      "paragraph_after": false
    },
    {
      "id": "S000108",
      "start": 664.28,
      "end": 667.98,
      "text": "صحه قانونی ملی را گذار.",
      "paragraph_after": true
    },
    {
      "id": "S000109",
      "start": 669.72,
      "end": 673.0,
      "text": "نمی‌توانم امروز در تمام جزئیات وارد بشوم",
      "paragraph_after": false
    },
    {
      "id": "S000110",
      "start": 673.0,
      "end": 679.32,
      "text": "بلکه فقط راجع به امور اصلاحات اراضی مختصری می‌پردازم.",
      "paragraph_after": true
    },
    {
      "id": "S000111",
      "start": 683.48,
      "end": 689.14,
      "text": "وقتی‌که قانون اصلاحات اراضی اول تصویب شد",
      "paragraph_after": false
    },
    {
      "id": "S000112",
      "start": 690.36,
      "end": 692.52,
      "text": "و ما به مراجع رفتیم",
      "paragraph_after": false
    },
    {
      "id": "S000113",
      "start": 695.36,
      "end": 697.9,
      "text": "و برنامه را اعلان کردیم.",
      "paragraph_after": false
    },
    {
      "id": "S000114",
      "start": 698.86,
      "end": 703.6,
      "text": "خیلی‌ها بودند که فکر می‌کردند این برنامه‌ها در مملکت عملی نیست.",
      "paragraph_after": false
    },
    {
      "id": "S000115",
      "start": 705.18,
      "end": 713.24,
      "text": "شاید اولین کسانی که از طرف اصلاحات ارضی به دهات مراغه فرستاده شده بودند،",
      "paragraph_after": false
    },
    {
      "id": "S000116",
      "start": 713.24,
      "end": 716.9,
      "text": "برای آن‌ها اسباب اشکال شد و از راه تهدید کردند.",
      "paragraph_after": false
    },
    {
      "id": "S000117",
      "start": 716.9,
      "end": 720.0,
      "text": "ولی دستور من به",
      "paragraph_after": false
    },
    {
      "id": "S000118",
      "start": 720.1,
      "end": 732.0,
      "text": "قوای مسلح مملکت این بود که با تمام قوا مجری این برنامه هستند",
      "paragraph_after": false
    },
    {
      "id": "S000119",
      "start": 732.0,
      "end": 742.06,
      "text": "و هر کسی که خواست حتی یک ثانیه در مقابل اجرای قانون حتی تأخیر بیندازد،",
      "paragraph_after": false
    },
    {
      "id": "S000120",
      "start": 743.64,
      "end": 751.3,
      "text": "آن شخص را خلع سلاح بکنند یعنی از صدمه رساندن او جلوگیری بکنند.",
      "paragraph_after": false
    },
    {
      "id": "S000121",
      "start": 754.1,
      "end": 760.62,
      "text": "در مراغه نصیحتی کردم که امروز دنیا چطور است",
      "paragraph_after": false
    },
    {
      "id": "S000122",
      "start": 760.62,
      "end": 764.68,
      "text": "و به عقیده من مالکیت چطور ممکن است ادامه داشته باشد.",
      "paragraph_after": false
    },
    {
      "id": "S000123",
      "start": 764.68,
      "end": 772.36,
      "text": "نصیحت من این بود که شما مالکین جایی که با زارع سرکار دارید،",
      "paragraph_after": false
    },
    {
      "id": "S000124",
      "start": 772.36,
      "end": 776.82,
      "text": "بهتر است که آن زمین را به زارع واگذار بکنید",
      "paragraph_after": false
    },
    {
      "id": "S000125",
      "start": 776.82,
      "end": 780.0,
      "text": "و خودتون با ماشین‌آلات در جایی که زارع نیست",
      "paragraph_after": false
    },
    {
      "id": "S000126",
      "start": 780.12,
      "end": 781.56,
      "text": "به کار بپردازید.",
      "paragraph_after": false
    },
    {
      "id": "S000127",
      "start": 781.56,
      "end": 790.06,
      "text": "البته گمان نمی‌کنم که همه از این حرف‌ها پند گرفتند یا خوششان آمد،",
      "paragraph_after": false
    },
    {
      "id": "S000128",
      "start": 791.5,
      "end": 795.04,
      "text": "ولی من نصیحت کرده بودم برای اینکه آتیه را می‌دیدم.",
      "paragraph_after": true
    },
    {
      "id": "S000129",
      "start": 797.92,
      "end": 799.64,
      "text": "چند صباحی گذشت.",
      "paragraph_after": false
    },
    {
      "id": "S000130",
      "start": 801.14,
      "end": 808.0,
      "text": "همان دو قوه‌ای که اتحاد غیرمقدس باطنی با هم داشتند،",
      "paragraph_after": false
    },
    {
      "id": "S000131",
      "start": 808.0,
      "end": 809.42,
      "text": "شروع به عمل کردند.",
      "paragraph_after": false
    },
    {
      "id": "S000132",
      "start": 811.84,
      "end": 816.92,
      "text": "مهندس ملک‌آبادی را در فارس به قتل رساندند.",
      "paragraph_after": false
    },
    {
      "id": "S000133",
      "start": 818.76,
      "end": 824.08,
      "text": "کشتن او ما را از اجرای برنامه منصرف نکرد.",
      "paragraph_after": false
    },
    {
      "id": "S000134",
      "start": 824.08,
      "end": 840.0,
      "text": "کشتن او شاید در تصمیمی که من برای گذاشتن به آرای عمومی هم",
      "paragraph_after": false
    },
    {
      "id": "S000135",
      "start": 840.04,
      "end": 849.68,
      "text": "لوایح اصلاحات ارضی و هم لوایح دیگری را که جامعه ایرانی را زی رو می‌کرد بی‌تأثیر نبود.",
      "paragraph_after": false
    },
    {
      "id": "S000136",
      "start": 851.0,
      "end": 861.76,
      "text": "آن عکس‌العمل خائنانه باعث تسریع در تصمیم گرفتن از طرف من و تأیید از طرف شما شد",
      "paragraph_after": false
    },
    {
      "id": "S000137",
      "start": 861.76,
      "end": 872.64,
      "text": "که به آن زندگی ناجوانمردانه و غیرقابل‌تحمل گذشته زودتر خاتمه بدهید.",
      "paragraph_after": true
    },
    {
      "id": "S000138",
      "start": 875.34,
      "end": 888.04,
      "text": "برنامه اصلاحات ارضی با فداکاری‌های حقیقتاً تمام مأمورین این سازمان ادامه داشت.",
      "paragraph_after": false
    },
    {
      "id": "S000139",
      "start": 889.7,
      "end": 899.32,
      "text": "جوان‌هایی که بدون فوق‌العاده حتی بدون خرج سفر،",
      "paragraph_after": false
    },
    {
      "id": "S000140",
      "start": 900.0,
      "end": 910.62,
      "text": "این دقیقه به آن‌ها می‌گفتند که بروید در فلان نقطه دورافتاده این مملکت، شاید بعد از چند ساعت این‌ها در راه بودند.",
      "paragraph_after": false
    },
    {
      "id": "S000141",
      "start": 912.7,
      "end": 927.02,
      "text": "حقوق‌هایی که به این‌ها می‌دادند ناچیز، تنها محرک این‌ها قطعاً ایمان به این برنامه بود و قطعاً به آینده‌ای که برای مملکت پیش خودشون تجسم می‌کردند.",
      "paragraph_after": false
    },
    {
      "id": "S000142",
      "start": 929.58,
      "end": 932.1,
      "text": "خدمات بی‌شائبه این‌ها ادامه داشت.",
      "paragraph_after": true
    },
    {
      "id": "S000143",
      "start": 934.12,
      "end": 942.3,
      "text": "شش بهمن آمد، شما ملت انقلاب ملی خود را تصویب کردید.",
      "paragraph_after": false
    },
    {
      "id": "S000144",
      "start": 942.3,
      "end": 951.32,
      "text": "ولی این هنوز به عمر خائنانه آن اتحاد نامقدس خاتمه نداده بود.",
      "paragraph_after": false
    },
    {
      "id": "S000145",
      "start": 953.28,
      "end": 957.44,
      "text": "دیدیم که بعد از ششم بهمن بعد از چند روزی",
      "paragraph_after": false
    },
    {
      "id": "S000146",
      "start": 958.24,
      "end": 960.0,
      "text": "یک مشت از خدا بی‌خبر",
      "paragraph_after": false
    },
    {
      "id": "S000147",
      "start": 960.16,
      "end": 971.02,
      "text": "سعی کردند که در فارس غائله‌ای را بیندازند که به فکر خودشون باعث رکود و شکست انقلاب ملی ما بشود.",
      "paragraph_after": false
    },
    {
      "id": "S000148",
      "start": 971.02,
      "end": 974.18,
      "text": "یک مشت مردم گمراه،",
      "paragraph_after": false
    },
    {
      "id": "S000149",
      "start": 974.18,
      "end": 979.98,
      "text": "یک مشت قاتلین حرفه‌ای و پیشه‌ای،",
      "paragraph_after": false
    },
    {
      "id": "S000150",
      "start": 979.98,
      "end": 986.72,
      "text": "با تحریک مرتجعین و مخربین،",
      "paragraph_after": false
    },
    {
      "id": "S000151",
      "start": 986.72,
      "end": 989.26,
      "text": "که ما اسنادش داریم،",
      "paragraph_after": false
    },
    {
      "id": "S000152",
      "start": 989.26,
      "end": 993.12,
      "text": "به خیال خودشون افتادند توی کوه‌ها",
      "paragraph_after": false
    },
    {
      "id": "S000153",
      "start": 994.84,
      "end": 999.16,
      "text": "که قتل ملک‌آبادی‌ها رو تجدید بکنن",
      "paragraph_after": false
    },
    {
      "id": "S000154",
      "start": 999.16,
      "end": 1003.82,
      "text": "و یا مرعوب بکنن و یا برنامه ما را متوقف.",
      "paragraph_after": false
    },
    {
      "id": "S000155",
      "start": 1005.34,
      "end": 1010.06,
      "text": "به حمدالله سربازهای رشید وطن شما،",
      "paragraph_after": false
    },
    {
      "id": "S000156",
      "start": 1011.76,
      "end": 1015.02,
      "text": "که متأسفانه آن‌ها نیز تلفات دادند",
      "paragraph_after": false
    },
    {
      "id": "S000157",
      "start": 1015.02,
      "end": 1019.68,
      "text": "و شاید تلفاتشون در حدود هفتاد تا هشتاد نفر بود",
      "paragraph_after": false
    },
    {
      "id": "S000158",
      "start": 1020.8,
      "end": 1021.7,
      "text": "از",
      "paragraph_after": false
    },
    {
      "id": "S000159",
      "start": 1022.98,
      "end": 1025.08,
      "text": "سرباز و ژاندارم و غیره،",
      "paragraph_after": false
    },
    {
      "id": "S000160",
      "start": 1025.08,
      "end": 1027.98,
      "text": "به آن غائله...",
      "paragraph_after": false
    },
    {
      "id": "S000161",
      "start": 1027.98,
      "end": 1029.54,
      "text": "خائنانه",
      "paragraph_after": false
    },
    {
      "id": "S000162",
      "start": 1029.54,
      "end": 1031.86,
      "text": "و در این حال بچگانه و مسخ",
      "paragraph_after": false
    },
    {
      "id": "S000163",
      "start": 1031.86,
      "end": 1033.9,
      "text": "پایان داد.",
      "paragraph_after": true
    },
    {
      "id": "S000164",
      "start": 1034.8,
      "end": 1036.16,
      "text": "بعد از آن",
      "paragraph_after": false
    },
    {
      "id": "S000165",
      "start": 1037.14,
      "end": 1039.88,
      "text": "پانزده خرداد را نیز ما داشتیم",
      "paragraph_after": false
    },
    {
      "id": "S000166",
      "start": 1039.88,
      "end": 1042.3,
      "text": "که بدترین",
      "paragraph_after": false
    },
    {
      "id": "S000167",
      "start": 1042.3,
      "end": 1044.34,
      "text": "مظاهر وحشیگری",
      "paragraph_after": false
    },
    {
      "id": "S000168",
      "start": 1045.38,
      "end": 1047.36,
      "text": "و عقب‌افتادگی",
      "paragraph_after": false
    },
    {
      "id": "S000169",
      "start": 1047.36,
      "end": 1054.84,
      "text": "و تحجر فکری نمایان شد که برای این مملکت ننگی بود",
      "paragraph_after": false
    },
    {
      "id": "S000170",
      "start": 1054.84,
      "end": 1063.18,
      "text": "که باز اراده قوی ملت ایران و همچنین وظیفه‌شناسی قوای مسلح",
      "paragraph_after": false
    },
    {
      "id": "S000171",
      "start": 1063.18,
      "end": 1066.2,
      "text": "در عرض مدت کوتاهی خاتمه داد.",
      "paragraph_after": true
    },
    {
      "id": "S000172",
      "start": 1066.2,
      "end": 1080.0,
      "text": "جواب پانزده خرداد رویه و تصمیم خلل‌ناپذیر شما در",
      "paragraph_after": false
    },
    {
      "id": "S000173",
      "start": 1081.06,
      "end": 1091.3,
      "text": "رفتن به پای صندوق‌ها در بیست و ششم شهریور و انتخاب کردن افرادی که به انقلاب ملی ما مؤمن بودند داده شد.",
      "paragraph_after": true
    },
    {
      "id": "S000174",
      "start": 1094.44,
      "end": 1105.78,
      "text": "بزرگترین پاداشی که ایران برای اظهار قدردانی به مأمورین اصلاحات ارضی و کشاورزی داد",
      "paragraph_after": false
    },
    {
      "id": "S000175",
      "start": 1105.78,
      "end": 1123.24,
      "text": "همانا که بیست و هشت نفر از وزارت کشاورزی و به‌خصوص ورزی را به نمایندگی از طرف خود برای مجلس شورای ملی انتخاب کرد.",
      "paragraph_after": true
    },
    {
      "id": "S000176",
      "start": 1123.24,
      "end": 1129.74,
      "text": "این بزرگترین افتخاری بود که ملت می‌توانست به این خدمتگزاران خود بدهد.",
      "paragraph_after": true
    },
    {
      "id": "S000177",
      "start": 1132.42,
      "end": 1138.08,
      "text": "بدانید ملت ایران که این وقایع مختصری که من برای شما شرح دادم",
      "paragraph_after": false
    },
    {
      "id": "S000178",
      "start": 1140.0,
      "end": 1150.38,
      "text": "پایه‌های آینده شما را به محکم‌ترین طریقی پی‌ریزی کرده است.",
      "paragraph_after": true
    },
    {
      "id": "S000179",
      "start": 1158.08,
      "end": 1164.08,
      "text": "روح اتحادی که من امروز در تمام طبقات ایران می‌بینم",
      "paragraph_after": false
    },
    {
      "id": "S000180",
      "start": 1165.48,
      "end": 1171.14,
      "text": "نه فقط در عمر من و در مدت سلطنت من بی‌سابقه است",
      "paragraph_after": false
    },
    {
      "id": "S000181",
      "start": 1172.06,
      "end": 1177.48,
      "text": "بلکه فکر می‌کنم کمتر زمانی در این مملکت دیده شده باشد.",
      "paragraph_after": true
    },
    {
      "id": "S000182",
      "start": 1178.78,
      "end": 1182.28,
      "text": "البته اطلاع داشتم و می‌دانستم",
      "paragraph_after": false
    },
    {
      "id": "S000183",
      "start": 1182.28,
      "end": 1187.44,
      "text": "ولی همین مسافرت چهارروزه به من فرصت آن را داد",
      "paragraph_after": false
    },
    {
      "id": "S000184",
      "start": 1187.44,
      "end": 1193.92,
      "text": "که اصلاً من در ایرانی یک قیافه جدیدی می‌بینم.",
      "paragraph_after": true
    },
    {
      "id": "S000185",
      "start": 1193.92,
      "end": 1200.0,
      "text": "این از بچه خردی که در دبستان بود",
      "paragraph_after": false
    },
    {
      "id": "S000186",
      "start": 1200.34,
      "end": 1204.76,
      "text": "تا جوان‌های بزرگتری که در دبیرستان‌ها بود",
      "paragraph_after": false
    },
    {
      "id": "S000187",
      "start": 1205.74,
      "end": 1208.56,
      "text": "در کاسبی که در شهر می‌دیدم",
      "paragraph_after": false
    },
    {
      "id": "S000188",
      "start": 1208.56,
      "end": 1213.76,
      "text": "در زارعی که در سر مسیر راه ما بود می‌دیدم",
      "paragraph_after": false
    },
    {
      "id": "S000189",
      "start": 1214.88,
      "end": 1218.02,
      "text": "در پیرمرد و پیرزن می‌دیدم",
      "paragraph_after": false
    },
    {
      "id": "S000190",
      "start": 1218.02,
      "end": 1223.16,
      "text": "و حتی بعضی اوقات در افراد افلیج",
      "paragraph_after": false
    },
    {
      "id": "S000191",
      "start": 1223.16,
      "end": 1225.8,
      "text": "که بعضی‌ها دست و پا نداشتند",
      "paragraph_after": false
    },
    {
      "id": "S000192",
      "start": 1225.8,
      "end": 1227.32,
      "text": "بعضی‌ها کور بودند",
      "paragraph_after": false
    },
    {
      "id": "S000193",
      "start": 1227.32,
      "end": 1229.68,
      "text": "این‌ها را من می‌دیدم",
      "paragraph_after": false
    },
    {
      "id": "S000194",
      "start": 1229.68,
      "end": 1236.26,
      "text": "که مثل یک پارچه آتش از زمین می‌جستند و فریاد می‌کشیدند.",
      "paragraph_after": true
    },
    {
      "id": "S000195",
      "start": 1236.26,
      "end": 1243.74,
      "text": "فریادی که مسلماً در استقبال از آینده ایران بود.",
      "paragraph_after": true
    },
    {
      "id": "S000196",
      "start": 1243.74,
      "end": 1247.78,
      "text": "آن کسی که کور است و دنیا را نمی‌بیند",
      "paragraph_after": false
    },
    {
      "id": "S000197",
      "start": 1247.78,
      "end": 1250.78,
      "text": "آن کسی که افلیج است و زمین‌گیره",
      "paragraph_after": false
    },
    {
      "id": "S000198",
      "start": 1250.78,
      "end": 1255.26,
      "text": "این برای چی این‌طور فریاد شادی می‌کشید؟",
      "paragraph_after": true
    },
    {
      "id": "S000199",
      "start": 1256.66,
      "end": 1258.62,
      "text": "مسلماً برای خودش که نبود",
      "paragraph_after": false
    },
    {
      "id": "S000200",
      "start": 1258.62,
      "end": 1259.9,
      "text": "چون",
      "paragraph_after": false
    },
    {
      "id": "S000201",
      "start": 1260.0,
      "end": 1263.34,
      "text": "او تقریباً از این دنیا محروم است",
      "paragraph_after": false
    },
    {
      "id": "S000202",
      "start": 1263.34,
      "end": 1268.46,
      "text": "ولی فریاد او برای بیست و یک میلیون نفر دیگر ایرانی بود",
      "paragraph_after": false
    },
    {
      "id": "S000203",
      "start": 1268.46,
      "end": 1270.84,
      "text": "برای این‌که مؤمن شده است",
      "paragraph_after": false
    },
    {
      "id": "S000204",
      "start": 1270.84,
      "end": 1274.12,
      "text": "که آینده شما تأمین است.",
      "paragraph_after": true
    },
    {
      "id": "S000205",
      "start": 1274.12,
      "end": 1280.74,
      "text": "این لازم نیست که این شخص حتماً یک استاد دانشگاه و پرفسور باشد که بفهمد",
      "paragraph_after": false
    },
    {
      "id": "S000206",
      "start": 1280.74,
      "end": 1286.58,
      "text": "وقتی یک چیزی حقیقت داشته باشد در قلب هر کسی خطور می‌کند.",
      "paragraph_after": true
    },
    {
      "id": "S000207",
      "start": 1286.58,
      "end": 1290.84,
      "text": "این شخص چه سواد داشته باشد چه نداشته باشد",
      "paragraph_after": false
    },
    {
      "id": "S000208",
      "start": 1290.84,
      "end": 1293.68,
      "text": "چه زارع باشد چه کاسب باشد",
      "paragraph_after": false
    },
    {
      "id": "S000209",
      "start": 1293.68,
      "end": 1297.78,
      "text": "چه پیرمرد باشد چه بچه خردسال باشد",
      "paragraph_after": false
    },
    {
      "id": "S000210",
      "start": 1297.78,
      "end": 1303.4,
      "text": "این اتحاد را من در ملت ایران به طور بی‌سابقه‌ای می‌بینم",
      "paragraph_after": false
    },
    {
      "id": "S000211",
      "start": 1303.4,
      "end": 1310.42,
      "text": "و همین رمز پیشرفت ما در مقابل تمام موانعی که سر راه ما بود",
      "paragraph_after": false
    },
    {
      "id": "S000212",
      "start": 1310.42,
      "end": 1315.54,
      "text": "امروز نه فقط کوچکترین مانعی دیگر باقی نیست",
      "paragraph_after": false
    },
    {
      "id": "S000213",
      "start": 1315.54,
      "end": 1319.66,
      "text": "بلکه این قوه نهانی و",
      "paragraph_after": false
    },
    {
      "id": "S000214",
      "start": 1320.0,
      "end": 1339.94,
      "text": "آتشینی که در تمام شماها می‌بینم، باعث این خواهد شد که در اندک مدتی ملت کهن‌سال ایران به سمت جلو، به سمت عالی‌ترین هدف‌های اجتماعی پرتاب بشود",
      "paragraph_after": false
    },
    {
      "id": "S000215",
      "start": 1339.94,
      "end": 1349.38,
      "text": "و با افتخار و سرفرازی، همدوش مترقی‌ترین ملل دنیا به پیش برود.",
      "paragraph_after": false
    },
    {
      "id": "S000216",
      "start": 1349.38,
      "end": 1357.18,
      "text": "خداوند همیشه یار و مددکار شما باشد.",
      "paragraph_after": true
    },
    {
      "id": "S000217",
      "start": 1377.64,
      "end": 1380.0,
      "text": "PYM JBZ",
      "paragraph_after": false
    },
    {
      "id": "S000218",
      "start": 1403.44,
      "end": 1406.24,
      "text": "PYM JBZ",
      "paragraph_after": false
    },
    {
      "id": "S000219",
      "start": 1408.0,
      "end": 1417.64,
      "text": "PYM JBZ",
      "paragraph_after": false
    }
  ]
}