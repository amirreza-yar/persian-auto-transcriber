{
  "version": "cleaned",
  "source_name": "1350-Pasargad-2500-Years-Celebration.mp3",
  "cues": [
    {
      "id": "S000001",
      "start": 28.36,
      "end": 29.8,
      "text": "پاینده باد ایران.",
      "paragraph_after": true
    },
    {
      "id": "S000002",
      "start": 31.32,
      "end": 46.3,
      "text": "شاهنشاه ایران و از جانب ملت من بر تو درود باد در این لحظه پرشکوه تاریخ ایران",
      "paragraph_after": false
    },
    {
      "id": "S000003",
      "start": 46.3,
      "end": 54.22,
      "text": "من و همه ایرانیان، همه فرزندان این شاهنشاهی کهن",
      "paragraph_after": false
    },
    {
      "id": "S000004",
      "start": 54.22,
      "end": 60.0,
      "text": "که ۲۵۰۰ سال پیش به دست تو بنیاد نهاده",
      "paragraph_after": false
    },
    {
      "id": "S000005",
      "start": 60.18,
      "end": 60.4,
      "text": "شد،",
      "paragraph_after": false
    },
    {
      "id": "S000006",
      "start": 60.4,
      "end": 63.62,
      "text": "در برابر آرامگاه تو",
      "paragraph_after": false
    },
    {
      "id": "S000007",
      "start": 63.62,
      "end": 65.46,
      "text": "سر ستایش",
      "paragraph_after": false
    },
    {
      "id": "S000008",
      "start": 65.46,
      "end": 68.5,
      "text": "فرود می‌آوریم",
      "paragraph_after": false
    },
    {
      "id": "S000009",
      "start": 68.5,
      "end": 70.12,
      "text": "و خاطره",
      "paragraph_after": false
    },
    {
      "id": "S000010",
      "start": 71.48,
      "end": 73.86,
      "text": "فراموش‌نشدنی تو را",
      "paragraph_after": false
    },
    {
      "id": "S000011",
      "start": 73.86,
      "end": 75.64,
      "text": "پاس می‌داریم.",
      "paragraph_after": true
    },
    {
      "id": "S000012",
      "start": 75.64,
      "end": 77.34,
      "text": "همه ما",
      "paragraph_after": false
    },
    {
      "id": "S000013",
      "start": 79.0,
      "end": 80.76,
      "text": "در این هنگام",
      "paragraph_after": false
    },
    {
      "id": "S000014",
      "start": 81.96,
      "end": 83.86,
      "text": "که ایران نو",
      "paragraph_after": false
    },
    {
      "id": "S000015",
      "start": 83.86,
      "end": 86.9,
      "text": "با افتخارات",
      "paragraph_after": false
    },
    {
      "id": "S000016",
      "start": 93.68,
      "end": 99.3,
      "text": "به نام قهرمان جاویدان تاریخ ایران،",
      "paragraph_after": false
    },
    {
      "id": "S000017",
      "start": 99.3,
      "end": 106.58,
      "text": "به نام بنیان‌گذار کهانسال‌ترین شاهنشاهی جهان،",
      "paragraph_after": false
    },
    {
      "id": "S000018",
      "start": 106.58,
      "end": 110.66,
      "text": "به نام آزادی‌بخش بزرگ تاریخ،",
      "paragraph_after": false
    },
    {
      "id": "S000019",
      "start": 110.66,
      "end": 114.74,
      "text": "به نام فرزند شایسته بشریت",
      "paragraph_after": false
    },
    {
      "id": "S000020",
      "start": 114.74,
      "end": 117.02,
      "text": "درود می‌فرستیم.",
      "paragraph_after": true
    },
    {
      "id": "S000021",
      "start": 120.08,
      "end": 128.24,
      "text": "کوروش، ما امروز در برابر آرامگاه ابدی تو گرد آمده‌ایم تا به تو بگوییم آسوده بخواب زیرا که ما بیداریم",
      "paragraph_after": false
    },
    {
      "id": "S000022",
      "start": 128.24,
      "end": 137.0,
      "text": "و برای نگاهبانی میراث پر افتخار تو همواره بیدار خواهیم بود.",
      "paragraph_after": true
    },
    {
      "id": "S000023",
      "start": 137.0,
      "end": 146.5,
      "text": "سوگند یاد می‌کنیم که آن پرچمی را که تو دو هزار و پانصد سال پیش برافراشتی،",
      "paragraph_after": false
    },
    {
      "id": "S000024",
      "start": 146.5,
      "end": 157.48,
      "text": "همچنان افراشته و در اهتزاز نگاه خواهیم داشت.",
      "paragraph_after": true
    },
    {
      "id": "S000025",
      "start": 159.54,
      "end": 166.0,
      "text": "سوگند یاد می‌کنیم که بزرگی و سربلندی این سرزمین را",
      "paragraph_after": false
    },
    {
      "id": "S000026",
      "start": 167.9,
      "end": 173.36,
      "text": "به عنوان ودیعه‌ای مقدس",
      "paragraph_after": false
    },
    {
      "id": "S000027",
      "start": 173.36,
      "end": 177.06,
      "text": "که گذشتگان ما به",
      "paragraph_after": false
    },
    {
      "id": "S000028",
      "start": 177.06,
      "end": 180.0,
      "text": "ما سپرده‌اند،",
      "paragraph_after": false
    },
    {
      "id": "S000029",
      "start": 180.02,
      "end": 181.1,
      "text": "با اراده‌ای پولادین حفظ خواهیم کرد",
      "paragraph_after": false
    },
    {
      "id": "S000030",
      "start": 181.1,
      "end": 186.62,
      "text": "و این کشور را سربلندتر و پیروزتر از همیشه",
      "paragraph_after": false
    },
    {
      "id": "S000031",
      "start": 186.62,
      "end": 192.62,
      "text": "به آیندگان خویش خواهیم سپرد.",
      "paragraph_after": true
    },
    {
      "id": "S000032",
      "start": 192.62,
      "end": 197.42,
      "text": "سوگند یاد می‌کنیم که سنت بشردوستی و نیک‌اندیشی را که تو",
      "paragraph_after": false
    },
    {
      "id": "S000033",
      "start": 197.42,
      "end": 205.26,
      "text": "اساس شاهنشاهی ایران قرار دادی،",
      "paragraph_after": false
    },
    {
      "id": "S000034",
      "start": 205.26,
      "end": 208.86,
      "text": "همواره پاس خواهیم داشت",
      "paragraph_after": false
    },
    {
      "id": "S000035",
      "start": 208.86,
      "end": 211.82,
      "text": "و همچنان برای مردم جهان پیام‌آور دوستی و حقیقت خواهیم بود.",
      "paragraph_after": true
    },
    {
      "id": "S000036",
      "start": 211.82,
      "end": 218.6,
      "text": "در این بیست و پنج قرن",
      "paragraph_after": false
    },
    {
      "id": "S000037",
      "start": 218.6,
      "end": 221.44,
      "text": "کشور تو و کشور من",
      "paragraph_after": false
    },
    {
      "id": "S000038",
      "start": 221.44,
      "end": 225.48,
      "text": "شاهد سنگین‌ترین حوادثی شد",
      "paragraph_after": false
    },
    {
      "id": "S000039",
      "start": 226.94,
      "end": 230.8,
      "text": "که در تاریخ جهان برای ملتی روی‌داده است.",
      "paragraph_after": true
    },
    {
      "id": "S000040",
      "start": 230.8,
      "end": 235.92,
      "text": "و با این همه هرگز",
      "paragraph_after": false
    },
    {
      "id": "S000041",
      "start": 237.52,
      "end": 240.0,
      "text": "این ملت در برابر دشواری‌های گران سر تسلیم فرود نیاورد.",
      "paragraph_after": true
    },
    {
      "id": "S000042",
      "start": 240.44,
      "end": 248.46,
      "text": "در طول دو هزار و پانصد سال هر وجب از خاک این مرز و بوم با خون دل دلیران و جانبازان ایران‌زمین آبیاری شد",
      "paragraph_after": false
    },
    {
      "id": "S000043",
      "start": 248.46,
      "end": 260.64,
      "text": "تا ایران همچنان زنده و سربلند بماند.",
      "paragraph_after": true
    },
    {
      "id": "S000044",
      "start": 260.64,
      "end": 264.82,
      "text": "بسیار کسان به این سرزمین روی آوردند",
      "paragraph_after": false
    },
    {
      "id": "S000045",
      "start": 266.76,
      "end": 271.26,
      "text": "تا آن را از پای درآورند،",
      "paragraph_after": false
    },
    {
      "id": "S000046",
      "start": 271.26,
      "end": 274.24,
      "text": "اما همه آنان رفتند و ایران بر جای ماند.",
      "paragraph_after": true
    },
    {
      "id": "S000047",
      "start": 274.24,
      "end": 280.64,
      "text": "و در همه این مدت",
      "paragraph_after": false
    },
    {
      "id": "S000048",
      "start": 280.64,
      "end": 283.26,
      "text": "علی‌رغم تیرگی‌ها، این سرزمین فروغ جاویدان",
      "paragraph_after": false
    },
    {
      "id": "S000049",
      "start": 283.26,
      "end": 288.88,
      "text": "همچنان تجلی‌گاه اخلاق و کانون ابدی اندیشه باقی‌ماند.",
      "paragraph_after": true
    },
    {
      "id": "S000050",
      "start": 288.88,
      "end": 294.86,
      "text": "اکنون ما در اینجا",
      "paragraph_after": false
    },
    {
      "id": "S000051",
      "start": 297.9,
      "end": 299.92,
      "text": "آمده‌ایم",
      "paragraph_after": false
    },
    {
      "id": "S000052",
      "start": 300.0,
      "end": 301.06,
      "text": "تا با سربلندی به تو بگوییم",
      "paragraph_after": false
    },
    {
      "id": "S000053",
      "start": 302.16,
      "end": 304.82,
      "text": "که پس از گذشت بیست و پنج قرن",
      "paragraph_after": false
    },
    {
      "id": "S000054",
      "start": 304.82,
      "end": 308.8,
      "text": "امروز نیز مانند دوران پر افتخار تو",
      "paragraph_after": false
    },
    {
      "id": "S000055",
      "start": 308.8,
      "end": 312.92,
      "text": "پرچم شاهنشاهی ایران پیروزمندانه در اهتزاز است.",
      "paragraph_after": true
    },
    {
      "id": "S000056",
      "start": 312.92,
      "end": 319.24,
      "text": "امروز نیز مانند روزگار تو",
      "paragraph_after": false
    },
    {
      "id": "S000057",
      "start": 319.24,
      "end": 323.56,
      "text": "نام ایران در سراسر گیتی",
      "paragraph_after": false
    },
    {
      "id": "S000058",
      "start": 323.56,
      "end": 326.54,
      "text": "با احترام و ستایش بسیار درآمیخته است.",
      "paragraph_after": true
    },
    {
      "id": "S000059",
      "start": 326.54,
      "end": 331.86,
      "text": "امروز نیز مانند عصر تو",
      "paragraph_after": false
    },
    {
      "id": "S000060",
      "start": 331.86,
      "end": 335.2,
      "text": "نام ایران در سراسر گیتی با احترام و ستایش بسیار درآمیخته است.",
      "paragraph_after": false
    },
    {
      "id": "S000061",
      "start": 335.2,
      "end": 338.42,
      "text": "ایران در صحنه پرآشوب جهان،",
      "paragraph_after": false
    },
    {
      "id": "S000062",
      "start": 338.42,
      "end": 342.96,
      "text": "پیام‌آور آزادگی و بشردوستی",
      "paragraph_after": false
    },
    {
      "id": "S000063",
      "start": 342.96,
      "end": 347.12,
      "text": "و پاسدار والاترین آرمان‌های انسانی است.",
      "paragraph_after": true
    },
    {
      "id": "S000064",
      "start": 347.12,
      "end": 350.44,
      "text": "مشعلی که تو برفروختی",
      "paragraph_after": false
    },
    {
      "id": "S000065",
      "start": 350.44,
      "end": 354.58,
      "text": "و در طول دو هزار و پانصد سال",
      "paragraph_after": false
    },
    {
      "id": "S000066",
      "start": 354.58,
      "end": 359.98,
      "text": "هرگز در برابر تندبادهای حوادث خاموش نشد.",
      "paragraph_after": true
    },
    {
      "id": "S000067",
      "start": 383.92,
      "end": 385.32,
      "text": "(موسیقی)",
      "paragraph_after": true
    },
    {
      "id": "S000068",
      "start": 388.0,
      "end": 394.52,
      "text": "ای مرد آزادمردان و قهرمان تاریخ ایران و جهان،",
      "paragraph_after": false
    },
    {
      "id": "S000069",
      "start": 394.52,
      "end": 404.26,
      "text": "آسوده بخواب زیرا که ما بیداریم و همواره بیدار خواهیم بود.",
      "paragraph_after": true
    }
  ]
}