COMPOSE_PROJECT_NAME=persian-stt

# Published application image. Customers normally stay on :stable.
APP_IMAGE=ghcr.io/amirreza-yar/persian-auto-transcriber:stable

# The launcher generates a random value on first run and keeps it stable.
APP_SECRET_KEY=__GENERATE_ON_FIRST_RUN__

LOG_LEVEL=INFO

# Secure default: accessible only from this Windows PC.
# Change to 0.0.0.0 only if other trusted LAN devices must access it.
API_BIND=127.0.0.1

DATA_VOLUME_NAME=persian-stt-data
MODEL_VOLUME_NAME=persian-stt-models

# A named Docker volume is used for /models. The model is downloaded on first
# use and retained across application updates.
WHISPER_LOCAL_FILES_ONLY=false

# No application SOCKS proxy in the customer setup. Gemini uses normal
# container networking, which should follow the Windows/Docker Desktop egress.
BOOTSTRAP_SOCKS5_PROXY=

# Keep the Windows PC responsive during long CPU transcriptions.
TRANSCRIBER_CPUS=2.5
